{
  "manifest_version": 3,
  "name": "Terraforming Mars Draft Checker",
  "version": "0.2.0",
  "description": "Record passed draft cards and estimate opponent choices using generation and map statistics.",
  "permissions": ["storage"],
  "background": {"service_worker": "background.js"},
  "action": {"default_title": "Terraforming Mars Draft Checker", "default_popup": "popup.html"},
  "content_scripts": [
    {"matches": ["*://boardgamearena.com/*", "*://*.boardgamearena.com/*"], "js": ["bridge.js"], "run_at": "document_start", "all_frames": true},
    {"matches": ["*://boardgamearena.com/*", "*://*.boardgamearena.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle", "all_frames": true, "world": "MAIN"}
  ]
}
